# SMTP account used by notify-systemd-failure.sh. Install as /etc/failure-mail.env,
# owned by root with mode 600. The Discourse container's SMTP settings
# (DISCOURSE_SMTP_* in /var/discourse/containers/web.yml) can be copied here.
SMTP_HOST=mail.classic-computing.de
SMTP_PORT=25
SMTP_USER=discourse
SMTP_PASSWORD=change-me
MAIL_FROM=noreply@discourse.classic-computing.de
MAIL_TO=hans.huebner.vzekc@gmail.com
